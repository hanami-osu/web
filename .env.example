# Hanami web configuration
# Rename this file to `.env`

# ── App

# Next.js server port.
PORT=3000

# Public URL of this deployment. Use http://localhost:3000 locally.
BETTER_AUTH_URL=https://hanami.yorunoken.com

# Signs and encrypts Better Auth data. Generate once per environment:
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Databases

# MariaDB URL for Hanami Web authentication and central identities.
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
WEB_DATABASE_URL=mysql://user:password@host:3306/hanami

# Existing Hanami Bot database, used for Discord-linked bot and osu! data.
BOT_DATABASE_URL=mysql://user:password@host:3306/hanami_bot

# Optional disposable MySQL database for integration tests. Never use real data.
TEST_DATABASE_URL=

# Run `bun run db:migrate` after configuring WEB_DATABASE_URL.

# ── Discord login 

# Create an app at https://discord.com/developers/applications and copy its
# Application ID and OAuth2 client secret.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Redirects: http://localhost:3000/api/auth/callback/discord (local)
# or https://hanami.yorunoken.com/api/auth/callback/discord (production).

# ── osu!guessr first-party OAuth/OIDC client

# Persisted public client identity and a comma-separated exact redirect URI allowlist.
# Use HTTPS in production. Loopback HTTP is accepted for local callbacks such as
# http://localhost:3000/api/auth/callback/hanami.
OSU_GUESSR_CLIENT_ID=
OSU_GUESSR_REDIRECT_URIS=

# Server-to-server channel used to hide, restore, and purge osu!guessr data for scheduled
# deletions, and to push Hanami supporter changes to osu!guessr. The secret must be at least 32 bytes and match osu!guessr's HANAMI_INTERNAL_SECRET.
OSU_GUESSR_INTERNAL_URL=http://localhost:3001
OSU_GUESSR_INTERNAL_SECRET=

# ── osu! linking

# Register an OAuth app at https://osu.ppy.sh/home/account/edit, then copy its
# client ID and secret. Register the Better Auth callback at /api/auth/callback/osu.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Optional: a separate osu! OAuth app for sign-in and linking. When set, these
# replace OSU_CLIENT_ID/OSU_CLIENT_SECRET for sign-in only; profile lookups keep
# using OSU_CLIENT_ID/OSU_CLIENT_SECRET. Leave them commented out unless you set
# both: an empty value counts as set.
# OSU_AUTH_CLIENT_ID=
# OSU_AUTH_CLIENT_SECRET=

# ── Bot account links

# Shared secret used when the bot requests a website link ticket. Put the same
# value in both deployments, but do not reuse BETTER_AUTH_SECRET.
# Generate with: openssl rand -hex 32
BOT_LINK_SECRET=

# ── Hanami supporter

# GitHub Sponsors: create a GitHub OAuth app with the callback
# <BETTER_AUTH_URL>/api/supporter/link/github/callback, and a Sponsors webhook
# (sponsorship events, application/json) at <BETTER_AUTH_URL>/api/supporter/webhooks/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SPONSORS_WEBHOOK_SECRET=

# Buy Me a Coffee: add a webhook at <BETTER_AUTH_URL>/api/supporter/webhooks/bmc for
# donation and membership events, and copy its signing secret.
BMC_WEBHOOK_SECRET=
