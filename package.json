{
    "name": "hanami-website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "bun --env-file=.env --bun next dev",
        "build": "bun run db:generate && bun --bun next build",
        "start": "bun --bun next start",
        "db:generate": "bunx prisma generate --schema prisma/web/schema.prisma && bunx prisma generate --schema prisma/bot/schema.prisma",
        "db:migrate": "bun src/scripts/migrate.ts",
        "db:reconcile-oauth-client": "bun src/scripts/reconcile-osu-guessr-client.ts",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "typecheck": "bun run db:generate && tsc --noEmit",
        "test": "bun test"
    },
    "dependencies": {
        "@better-auth/oauth-provider": "1.7.3",
        "@fontsource-variable/public-sans": "5.3.0",
        "@fontsource-variable/sora": "5.3.0",
        "@prisma/adapter-mariadb": "7.10.0",
        "@prisma/client": "7.10.0",
        "better-auth": "1.7.3",
        "clsx": "^2.1.1",
        "dotenv": "^17.4.2",
        "elysia": "^1.4.28",
        "lucide-react": "^0.536.0",
        "next": "16.4.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@types/bun": "^1.4.4",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "prettier": "^3.9.5",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "prisma": "7.10.0",
        "tailwindcss": "^4.1.11",
        "typescript": "^5",
        "typescript-eslint": "^8",
        "@tailwindcss/postcss": "^4.3.3"
    },
    "packageManager": "bun@1.4.4"
}
